# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# Copy to frontend/.env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Get a free token at https://mapbox.com → Account → Access tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── Backend (FastAPI) ────────────────────────────────────────────────────────
# Copy to backend/.env

# Supabase Postgres connection string (with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civicfix

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=report-images

# AI — Phase 4
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# App
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
RESIDENT_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3000/admin

# Notifications — Phase 6
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
EMAIL_API_KEY=SG...
EMAIL_FROM=no-reply@civicfix.local

# ─── MCP Server ───────────────────────────────────────────────────────────────
# Copy to mcp-server/.env

MCP_SERVER_NAME=city-ops-mcp
